# Copy to .env and fill in. Never commit .env.
# "convention" = name chosen by us; the provider's SDK does not read it automatically.
# Load into Modal as one secret: uv run modal secret create hackbench --from-dotenv .env --force

# App: public URL the agent card and llms.txt advertise (local default: http://localhost:8000)
HACKBENCH_BASE_URL=
# Use-case profile in src/hackbench/profiles/<name>.toml (default: polaron)
HACKBENCH_PROFILE=
# Folder of batch subfolders with SEM TIFFs for `make qc` (default: data/polaron, git-ignored)
HACKBENCH_DATA_DIR=

# Anthropic: Claude API (read by the official SDKs)
ANTHROPIC_API_KEY=

# Modal: only needed in CI. Locally, `uv run modal token new` writes ~/.modal.toml instead.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Hugging Face: HF Jobs, ZeroGPU, model downloads (read by huggingface_hub)
HF_TOKEN=

# Cognition: Devin API (convention)
DEVIN_API_KEY=

# Amass: life-sciences data API (convention)
AMASS_API_KEY=

# GXL: Paperclip literature platform (convention)
GXL_API_KEY=

# TypeSafe: Jev decision model (convention)
TYPESAFE_API_KEY=

# Google DeepMind Antigravity: IDE login via personal code, no env var needed
