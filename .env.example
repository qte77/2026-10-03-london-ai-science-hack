# Copy to .env and fill in. Never commit .env.
# "convention" = name chosen by us; the provider's SDK does not read it automatically.
# Load into Modal as one secret: uv run modal secret create hackbench --from-dotenv .env --force

# App: public URL the agent card and llms.txt advertise (local default: http://localhost:8000)
HACKBENCH_BASE_URL=
# Use-case profile in src/hackbench/profiles/<name>.toml (default: polaron)
HACKBENCH_PROFILE=
# Folder of batch subfolders with SEM TIFFs for `make qc` (default: data/polaron, git-ignored)
HACKBENCH_DATA_DIR=
# OpenAI-compatible base URL of the paper judge's LLM (the Modal-hosted model); optional
HACKBENCH_LLM_URL=

# Anthropic: Claude API (read by the official SDKs)
ANTHROPIC_API_KEY=

# Modal: only needed in CI (repo secrets). Locally, `uv run modal token new` writes ~/.modal.toml
# instead. Leave these out of the .env you push into the Modal secret.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Cloudflare Workers AI: fallback LLM judge (OpenAI-compatible /ai/v1/chat/completions).
# Dashboard: AI > Workers AI > "Use REST API" shows both; or `wrangler whoami` / `wrangler auth token`.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Hugging Face: HF Jobs, ZeroGPU, model downloads (read by huggingface_hub)
HF_TOKEN=

# Cognition: Devin API (convention)
DEVIN_API_KEY=

# Amass: life-sciences data API (convention)
AMASS_API_KEY=

# GXL Paperclip: paper search, cleaned paper data, /claims/support (REST, header X-API-Key).
# Create at https://paperclip.gxl.ai/keys. Read by the cycle's papers + paper_judge stages;
# PAPERCLIP_API_KEY (the name Paperclip's own SDK reads) also works.
GXL_API_KEY=

# TypeSafe: Jev decision model (convention)
TYPESAFE_API_KEY=

# Google DeepMind Antigravity: IDE login via personal code, no env var needed
